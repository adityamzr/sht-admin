# ── Database: PostgreSQL (Neon di production) ──────────────────
# CLI tools (npm run db:migrate / db:seed / admin:create) membaca DATABASE_URL.
# Neon (region Singapore):  "postgresql://USER:PASSWORD@ep-xxx.ap-southeast-1.aws.neon.tech/sht?sslmode=require"
# Lokal (development):     "postgresql://user:pass@localhost:5432/sht_dev"
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/sht_dev"

# ── Runtime app (Nuxt/Nitro) ───────────────────────────────────
# Konvensi Nitro: runtimeConfig membaca NUXT_ prefixed env.
# Di Vercel, set kedua variabel ini di Environment Variables.
NUXT_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/sht_dev"

# Secret untuk seal cookie session admin (HMAC-SHA256). WAJIB ≥ 32 karakter acak.
# Production: generate sekali dan simpan di environment Vercel (jangan commit).
NUXT_SESSION_SECRET="ganti-dengan-random-string-min-32-karakter"

# ── Seed development ───────────────────────────────────────────
# Password admin dev yang dibuat npm run db:seed (fallback dev-only bila kosong).
ADMIN_DEV_PASSWORD=""

# ── Buat admin production (satu-off) ───────────────────────────
#   ADMIN_EMAIL="admin@sudutharamain.id" ADMIN_NAME="Admin SHT" \
#   ADMIN_PASSWORD="password-min-12-karakter" npm run admin:create
# Tidak ada password production yang di-commit — selalu lewat env.
