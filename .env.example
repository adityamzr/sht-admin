# ── Database (PostgreSQL / Neon) ────────────────────────────────
# SATU variabel untuk semua konteks: CLI (db:migrate / db:seed /
# admin:create), dev server Nuxt, dan environment Vercel (runtime).
# Tidak perlu export manual — skrip CLI memuat .env ini otomatis.
# Neon (Singapore):  "postgresql://USER:PASSWORD@ep-xxx.ap-southeast-1.aws.neon.tech/sht?sslmode=require"
# Lokal (development): "postgresql://user:pass@localhost:5432/sht_dev"
NUXT_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/sht_dev"
# Catatan: CLI juga menerima DATABASE_URL sebagai fallback kompatibilitas
# (mis. copy-paste connection string Neon). NUXT_DATABASE_URL tetap resmi.

# ── Session admin ───────────────────────────────────────────────
# Secret untuk seal cookie session admin (HMAC-SHA256). WAJIB ≥ 32 karakter acak.
# Production: generate sekali dan simpan di environment Vercel (jangan commit).
NUXT_SESSION_SECRET="ganti-dengan-random-string-min-32-karakter"

# ── Seed development ────────────────────────────────────────────
# Password admin dev yang dibuat npm run db:seed (fallback dev-only bila kosong).
ADMIN_DEV_PASSWORD=""

# ── Buat admin production (satu-off; bisa diisi di .env ini) ────
# ADMIN_EMAIL="admin@sudutharamain.id"
# ADMIN_NAME="Admin SHT"
# ADMIN_PASSWORD="password-min-12-karakter"
# lalu jalankan: npm run admin:create
# Tidak ada password production yang di-commit — selalu lewat env.
