# ── Database: PostgreSQL via Neon ─────────────────────────────
# Dibutuhkan mulai M3 (Domain Model & Database).
# Buat project di neon.tech (region: Singapore / ap-southeast-1), paste connection string:
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/sht?sslmode=require"

# ── Auth admin (M5 — Core Admin Operations) ───────────────────
# Secret acak panjang untuk sesi/JWT. WAJIB diganti dengan nilai produksi.
NUXT_SESSION_SECRET="ganti-dengan-random-string-panjang"

# NOTE (M0): kedua variabel di atas belum dibutuhkan untuk M0–M4.
# /api/health dan dashboard admin tetap berjalan tanpa konfigurasi apa pun.
# Nilai produksi (secret asli, kredensial Neon) TIDAK BOLEH di-commit.
